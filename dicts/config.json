        "files": "个文件",
        "folder": "个文件夹",
        "folders": "个文件夹",
        "search": "次搜索",
        "searches": "次搜索",
        "command": "个命令",
        "commands": "个命令",
        "task": "个任务",
        "tasks": "个任务",
        "page": "个网页",
        "pages": "个网页",
        "browser": "次浏览器操作",
        "browsers": "次浏览器操作",
        "image": "张图片",
        "images": "张图片",
        "action": "项操作",
        "actions": "项操作",
        "artifact": "个 Artifact",
        "artifacts": "个 Artifact"
    },
    "fragmentPatterns": [
        {
            "containerPattern": "^(?:Show|显示另外)\\s+\\d+\\s+(?:more|个)(?:\\.\\.\\.|…)?$",
            "nodeReplacements": [
                { "match": "^Show\\s*$", "replace": "显示另外 " },
                { "match": "^more(\\.\\.\\.|…)?$", "replace": " 个$1", "normalizeEllipsis": true }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|暂无).+\\s+yet$",
            "nodeReplacements": [
                { "match": "^No\\s*$", "replace": "暂无" },
                { "match": "^\\s*yet\\s*$", "replace": "" }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|没有).+(?:\\s+match\\s+|匹配\\s*)[“\"].+[”\"]\\.?$",
            "nodeReplacements": [
                { "match": "^No\\s*$", "replace": "没有" },
                { "match": "^\\s*match\\s+[“\"]$", "replace": "匹配 “" },
                { "match": "^\\s*[”\"]\\.\\s*$", "replace": "”。" }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|未找到\\s*).+\\s+found$",
            "nodeReplacements": [
                { "match": "^No\\s*$", "replace": "未找到 " },
                { "match": "^\\s*found\\s*$", "replace": "" }
            ]
        }
    ]
}
