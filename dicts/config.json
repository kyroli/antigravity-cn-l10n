        "rules": [
            {
                "pattern": "^From (@?(?![Hh]ere$|[Nn]ow$|[Aa]bove$|[Bb]elow$|[Tt]oday$|[Yy]esterday$)[A-Za-z0-9][A-Za-z0-9._-]*)$",
                "replacement": "来自 $1",
                "caseSensitive": true,
                "rawGroups": [
                    1
                ]
            },
            {
                "pattern": "^To (@?(?![Cc]ontinue$|[Ss]tart$|[Bb]egin$|[Pp]roceed$|[Cc]ancel$|[Vv]iew$|[Ee]dit$|[Oo]pen$|[Cc]lose$|[Cc]opy$|[Dd]elete$|[Rr]etry$|[Ss]kip$|[Ss]ubmit$|[Cc]onfirm$|[Ss]ave$|[Ee]xit$|[Qq]uit$|[Ll]earn$|[Rr]ead$|[Ss]ee$|[Rr]un$|[Gg]et$|[Ss]et$|[Aa]dd$|[Uu]se$|[Dd]o$|[Bb]e$|[Gg]o$|[Mm]e$|[Uu]s$|[Yy]ou$|[Tt]hem$|[Ii]t$|[Aa]ll$)[A-Za-z0-9][A-Za-z0-9._-]*)$",
                "replacement": "发给 $1",
                "caseSensitive": true,
                "rawGroups": [
                    1
                ]
            },
            {
                "pattern": "^Thinking: ([\\s\\S]+)$",
                "replacement": "正在思考：$1",
                "rawGroups": [
                    1
                ]
            },
            {
                "pattern": "^Latest action: (Read|Write|Edit|Search) (.+)$",
                "replacement": "最新操作：$1 $2",
                "rawGroups": [
                    2
                ]
            },
            {
                "pattern": "^Latest action: ([\\s\\S]+)$",
                "replacement": "最新操作：$1"
            },
            {
                "pattern": "^Showing the last good view\\.json; the current file is (.+)$",
                "replacement": "当前显示的是上一次正常的 view.json；当前文件$1"
            }
        ]
    },
