    "fragmentPatterns": [
        {
            "containerPattern": "^(?:Show|显示另外)\\s+\\d+\\s+(?:more|个)(?:\\.\\.\\.|…)?$",
            "nodeReplacements": [
                {
                    "match": "^Show\\s*$",
                    "replace": "显示另外 "
                },
                {
                    "match": "^\\s*more(\\.\\.\\.|…)?$",
                    "replace": " 个$1",
                    "normalizeEllipsis": true
                }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|暂无).+\\s+yet$",
            "nodeReplacements": [
                {
                    "match": "^No\\s*$",
                    "replace": "暂无"
                },
                {
                    "match": "^\\s*yet\\s*$",
                    "replace": ""
                }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|没有).+(?:\\s+match\\s+|匹配)[“\"].+[”\"]\\.?$",
            "nodeReplacements": [
                {
                    "match": "^No\\s*$",
                    "replace": "没有"
                },
                {
                    "match": "^\\s*match\\s+[“\"]$",
                    "replace": "匹配“"
                },
                {
                    "match": "^\\s*[”\"]\\.\\s*$",
                    "replace": "”。"
                },
                {
                    "match": "^\\s*[”\"]\\s*$",
                    "replace": "”"
                }
            ]
        },
        {
            "containerPattern": "^(?:No\\s+|未找到\\s*).+\\s+found$",
            "nodeReplacements": [
                {
                    "match": "^No\\s*$",
                    "replace": "未找到 "
                },
                {
                    "match": "^\\s*found\\s*$",
                    "replace": ""
                }
            ]
        },
        {
            "containerPattern": "^(?:Customize your experience across the agent|在设置和插件市场中自定义您在 Agent).+(?:says\\.?|的回答。)$",
            "nodeReplacements": [
                {
                    "match": "^Customize your experience.*influence what\\s*$",
                    "replace": "在设置和插件市场中自定义您在 Agent、插件和产品中的体验。我们绝不会向您展示广告，也不会让广告商影响 "
                },
                {
                    "match": "^\\s*says\\.?\\s*$",
                    "replace": " 的回答。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Attackers might be trying to steal your information from\\s+|攻击者可能正试图窃取您在\\s*).+\\s+(?:\\(for example, passwords, messages, or credit cards\\)\\.|上的信息（例如密码、消息或信用卡信息）。)$",
            "nodeReplacements": [
                {
                    "match": "^Attackers might be trying to steal your information from\\s*$",
                    "replace": "攻击者可能正试图窃取您在"
                },
                {
                    "match": "^\\s*\\(for example, passwords, messages, or credit cards\\)\\.\\s*$",
                    "replace": " 上的信息（例如密码、消息或信用卡信息）。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Get Anything Done with(?:\\s+the)?|高效完成任何任务，尽在)\\s+.+$",
            "nodeReplacements": [
                {
                    "match": "^Get Anything Done with(?:\\s+the)?\\s+$",
                    "replace": "高效完成任何任务，尽在 "
                }
            ]
        },
        {
            "containerPattern": "^(?:(?:Powered by Gemini Live\\s*·|由 Gemini Live 提供支持\\s*·)\\s*)?(?:You can change this in|您稍后可在)\\s+(?:Settings|设置)\\s+(?:later\\.|中更改此设置。)$",
            "nodeReplacements": [
                {
                    "match": "^Powered by Gemini Live\\s*·\\s*$",
                    "replace": "由 Gemini Live 提供支持 · "
                },
                {
                    "match": "^You can change this in\\s*$",
                    "replace": "您稍后可在"
                },
                {
                    "match": "^\\s*later\\.\\s*$",
                    "replace": "中更改此设置。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Stream and control|直接在侧边栏中流式传输与控制)\\s+.+(?:\\s+directly in the side pane\\.|。)$",
            "nodeReplacements": [
                {
                    "match": "^Stream and control\\s+$",
                    "replace": "直接在侧边栏中流式传输与控制 "
                },
                {
                    "match": "^\\s+directly in the side pane\\.$",
                    "replace": "。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Remote Control isn't active on this instance\\. Enable it in|远程控制未在此实例上启用。请(?:在|前往))\\s+(?:Settings|设置)(?:,\\s*then reopen this dialog\\.|\\s+中启用，然后重新打开此对话框。)$",
            "nodeReplacements": [
                {
                    "match": "^Remote Control isn't active on this instance\\. Enable it in\\s*$",
                    "replace": "远程控制未在此实例上启用。请在"
                },
                {
                    "match": "^,\\s*then reopen this dialog\\.\\s*$",
                    "replace": " 中启用，然后重新打开此对话框。"
                }
            ]
        },
        {
            "containerPattern": "^(?:To switch accounts, sign out in the|要切换账户，请先在)\\s+(?:Accounts tab|[\"“]账户[\"”]标签页)(?:\\s+and sign in again\\.|\\s+中退出登录，然后重新登录。)$",
            "nodeReplacements": [
                {
                    "match": "^To switch accounts, sign out in the\\s*$",
                    "replace": "要切换账户，请先在 "
                },
                {
                    "match": "^\\s*and sign in again\\.\\s*$",
                    "replace": " 中退出登录，然后重新登录。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Hold|按住)\\s+.+(?:\\s+to add to Agent|\\s+to upload|\\s+以添加到 Agent|\\s+以上传)$",
            "nodeReplacements": [
                {
                    "match": "^Hold\\s+$",
                    "replace": "按住 "
                },
                {
                    "match": "^\\s+to add to Agent$",
                    "replace": " 以添加到 Agent"
                },
                {
                    "match": "^\\s+to upload$",
                    "replace": " 以上传"
                }
            ]
        },
        {
            "containerPattern": "^(?:An\\s+|此电脑上已存在同名的\\s*).+(?:\\s+with this name already exists on this computer\\. Run it remotely, or go back and rename it\\.|。请改为远程运行，或返回并重命名。)$",
            "nodeReplacements": [
                {
                    "match": "^An\\s+$",
                    "replace": "此电脑上已存在同名的 "
                },
                {
                    "match": "^\\s+with this name already exists on this computer\\. Run it remotely, or go back and rename it\\.$",
                    "replace": "。请改为远程运行，或返回并重命名。"
                }
            ]
        },
        {
            "containerPattern": "^(?:A\\s+|已存在同名的\\s*).+(?:\\s+with this name already exists\\.|。)$",
            "nodeReplacements": [
                {
                    "match": "^A\\s+$",
                    "replace": "已存在同名的 "
                },
                {
                    "match": "^\\s+with this name already exists\\.$",
                    "replace": "。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Microphone blocked\\. Allow in|麦克风已被阻止。请在)\\s+(?:Privacy Settings|System Settings|隐私设置|系统设置)(?:\\.|\\s+中允许。)$",
            "nodeReplacements": [
                {
                    "match": "^Microphone blocked\\. Allow in\\s*$",
                    "replace": "麦克风已被阻止。请在 "
                },
                {
                    "match": "^\\.$",
                    "replace": " 中允许。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Click|点击)\\s*(?:Open|打开)\\s*↗\\s*(?:to open macOS Privacy & Security\\.|打开 macOS[“\"]隐私与安全性[””]。)$",
            "nodeReplacements": [
                {
                    "match": "^Click\\s*$",
                    "replace": "点击 "
                },
                {
                    "match": "^\\s*to open macOS Privacy & Security\\.\\s*$",
                    "replace": " 打开 macOS“隐私与安全性”。"
                }
            ]
        },
        {
            "containerPattern": "^(?:No hosts in\\s+|在\\s*).+(?:\\s+yet\\. Type one above\\.|\\s*中尚无主机。请在上方输入。)$",
            "nodeReplacements": [
                {
                    "match": "^No hosts in\\s*$",
                    "replace": "在 "
                },
                {
                    "match": "^\\s*yet\\. Type one above\\.\\s*$",
                    "replace": " 中尚无主机。请在上方输入。"
                }
            ]
        }
    ],
