    "fragmentPatterns": [
        {
            "containerPattern": "^(?:(?:Powered by Gemini Live\\s*·|由 Gemini Live 提供支持\\s*·)\\s*)?(?:You can change this in|您稍后可在)\\s+(?:Settings|设置)\\s+(?:later\\.|中更改此设置。)$",
            "nodeReplacements": [
                {
                    "match": "^Powered by Gemini Live\\s*·\\s*$",
                    "replace": "由 Gemini Live 提供支持 · "
                },
                {
                    "match": "^You can change this in\\s*$",
                    "replace": "您稍后可在"
                },
                {
                    "match": "^\\s*later\\.\\s*$",
                    "replace": "中更改此设置。"
                }
            ]
        },
        {
            "containerPattern": "^(?:An\\s+(?:automation|自动化任务)\\s+with this name already exists on this computer\\. Run it remotely, or go back and rename it\\.|此电脑上已存在同名的\\s*.+?。请改为远程运行，或返回并重命名。)$",
            "nodeReplacements": [
                {
                    "match": "^An\\s+$",
                    "replace": "此电脑上已存在同名的 "
                },
                {
                    "match": "^automation$",
                    "replace": "自动化任务"
                },
                {
                    "match": "^\\s+with this name already exists on this computer\\. Run it remotely, or go back and rename it\\.$",
                    "replace": "。请改为远程运行，或返回并重命名。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Daily|Weekdays|Weekly|每天|工作日|每周)(?:\\s+(?:on\\s+)?\\S+)?\\s+(?:around|左右|约)\\s+.+$",
            "nodeReplacements": [
                {
                    "match": "^\\s*on\\s*$",
                    "replace": " "
                },
                {
                    "match": "^\\s*around\\s*$",
                    "replace": " 约 "
                }
            ]
        },
        {
            "containerPattern": "^(?:Current parameter:|当前参数：).+?(?:\\(still loading(?:\\.\\.\\.|…)\\)\\.?|（仍在加载...）。?)$",
            "nodeReplacements": [
                {
                    "match": "^Current parameter:\\s*$",
                    "replace": "当前参数："
                },
                {
                    "match": "^\\. Active workspace URI:\\s*$",
                    "replace": "。当前工作区 URI："
                },
                {
                    "match": "^\\. Applying or clearing reloads the window\\. Suggestions come from your recent workspaces and the folders of your existing projects and their environments\\s*$",
                    "replace": "。应用或清除将会重新加载窗口。建议列表来自您最近的工作区以及现有项目及其环境的文件夹"
                },
                {
                    "match": "^\\s*\\(still loading(?:\\.\\.\\.|…)\\)$",
                    "replace": "（仍在加载...）"
                },
                {
                    "match": "^\\.$",
                    "replace": "。"
                }
            ]
        },
        {
            "containerPattern": "^(?:This project was created for|此项目专为).+?(?:automation\\.|自动化任务创建。).*$",
            "matchNested": true,
            "nodeReplacements": [
                {
                    "match": "^This project was created for$",
                    "replace": "此项目专为"
                },
                {
                    "match": "^the\\s*$",
                    "replace": ""
                },
                {
                    "match": "^an$",
                    "replace": "某项"
                },
                {
                    "match": "^automation\\.\\s*$",
                    "replace": "自动化任务创建。"
                }
            ]
        },
        {
            "containerPattern": "^\\+.+?\\s+(?:more\\s+line(?:lines|s)?|更多\\s*行)$",
            "nodeReplacements": [
                {
                    "match": "^\\s+more$",
                    "replace": " 更多"
                },
                {
                    "match": "^lines?$",
                    "replace": "行"
                }
            ]
        },
        {
            "containerPattern": "^(?:Already on\\? Select|已开启？请先选中)\\s+.+(?:drag it back in from the small window\\.|从“系统设置”旁的小窗口中将其拖回。)$",
            "nodeReplacements": [
                {
                    "match": "^Already on\\? Select\\s*$",
                    "replace": "已开启？请先选中 "
                },
                {
                    "match": "^, click\\s*$",
                    "replace": "，点击 "
                },
                {
                    "match": "^,\\s*then\\s*$",
                    "replace": "，然后"
                },
                {
                    "match": "^\\s*drag it back in from the small window\\.\\s*$",
                    "replace": "从“系统设置”旁的小窗口中将其拖回。"
                }
            ]
        },
        {
            "containerPattern": "^\\d+\\s+(?:insertions?|处新增\\s*s?)\\s*\\(\\+\\)$",
            "nodeReplacements": [
                {
                    "match": "^\\s+insertions?$",
                    "replace": " 处新增"
                },
                {
                    "match": "^s$",
                    "replace": ""
                }
            ]
        },
        {
            "containerPattern": "^\\d+\\s+(?:deletions?|处删除\\s*s?)\\s*\\(-\\)$",
            "nodeReplacements": [
                {
                    "match": "^\\s+deletions?$",
                    "replace": " 处删除"
                },
                {
                    "match": "^s$",
                    "replace": ""
                }
            ]
        },
        {
            "containerPattern": "^(?:For corp passwords \\(such as|对于公司内网密码（如).+?(?:allow the next prompt and re-run your command\\.|请允许下一个提示并重新运行您的命令。)$",
            "matchNested": true,
            "nodeReplacements": [
                {
                    "match": "^For corp passwords \\(such as\\s+$",
                    "replace": "对于公司内网密码（如 "
                },
                {
                    "match": "^\\s+or$",
                    "replace": " 或"
                },
                {
                    "match": "^or\\s+$",
                    "replace": "或 "
                },
                {
                    "match": "^\\), use an external SSH session$",
                    "replace": "），请使用外部 SSH 会话"
                },
                {
                    "match": "^\\. For non-corp passwords or SSH passphrases, allow the next prompt and re-run your command\\.$",
                    "replace": "。对于非公司内网密码或 SSH 密钥口令，请允许下一个提示并重新运行您的命令。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Project\\s+.+?\\s+already exists for this\\s+(?:combination of folders|folder)+\\. Would you like to continue using it or make a new one\\?|项目\\s+.+?\\s+已存在于此(?:文件夹组合|文件夹)中。您想继续使用它还是新建一个？)$",
            "nodeReplacements": [
                {
                    "match": "^Project\\s+$",
                    "replace": "项目 "
                },
                {
                    "match": "^\\s+already exists for this\\s+$",
                    "replace": " 已存在于此"
                },
                {
                    "match": "^combination of folders$",
                    "replace": "文件夹组合"
                },
                {
                    "match": "^folder$",
                    "replace": "文件夹"
                },
                {
                    "match": "^\\. Would you like to continue using it or make a new one\\?$",
                    "replace": " 中。您想继续使用它还是新建一个？"
                }
            ]
        },
        {
            "containerPattern": "^(?:An\\s+(?:automation|自动化任务)\\s+with the ID [“\"].+?[”\"] already exists\\.|已存在(?:自动化任务（ID：[“\"].+?[”\"]）| ID 为[“\"].+?[”\"]的自动化任务)。)$",
            "nodeReplacements": [
                {
                    "match": "^An\\s+$",
                    "replace": "已存在"
                },
                {
                    "match": "^automation$",
                    "replace": "自动化任务"
                },
                {
                    "match": "^\\s+with the ID [“\"]$",
                    "replace": "（ID：“"
                },
                {
                    "match": "^[”\"] already exists\\.$",
                    "replace": "”）。"
                }
            ]
        },
        {
            "containerPattern": "^,\\s*(?:from\\s+.+|来自.+)$",
            "nodeReplacements": [
                {
                    "match": "^from a plugin$",
                    "replace": "来自插件"
                },
                {
                    "match": "^from\\s+(.+)$",
                    "replace": "来自 $1"
                }
            ]
        },
        {
            "containerPattern": "^(?:Commit\\s+.+?\\s+file\\s+(?:changes?|changechanges)\\s+to|提交\\s+.+?\\s+个文件变更至)$",
            "nodeReplacements": [
                {
                    "match": "^Commit\\s+$",
                    "replace": "提交 "
                },
                {
                    "match": "^\\s+file$",
                    "replace": " 个文件"
                },
                {
                    "match": "^\\s+$",
                    "replace": ""
                },
                {
                    "match": "^changes?$",
                    "replace": "变更"
                },
                {
                    "match": "^\\s+to$",
                    "replace": "至"
                }
            ]
        },
        {
            "containerPattern": "^\\((?:\\d+\\s+subagents?|\\d+\\s+个子 Agent)\\)$",
            "nodeReplacements": [
                {
                    "match": "^\\s+subagent$",
                    "replace": " 个子 Agent"
                },
                {
                    "match": "^s$",
                    "replace": ""
                }
            ]
        },
        {
            "containerPattern": "^(?:Permanently delete\\s+.+?\\.|永久删除\\s+.+?。)$",
            "matchNested": true,
            "nodeReplacements": [
                {
                    "match": "^Permanently delete$",
                    "replace": "永久删除"
                },
                {
                    "match": "^\\s*including\\s+$",
                    "replace": "，包括 "
                },
                {
                    "match": "^\\.$",
                    "replace": "。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Previous chats live under a deprecated Google3 Project\\s+\\(.+?\\)\\.\\s+New chats will be grouped by workspace\\.|历史聊天记录归属于已废弃的 Google3 项目（.+?）。新对话将按工作区进行分组归类。)$",
            "nodeReplacements": [
                {
                    "match": "^Previous chats live under a deprecated Google3 Project$",
                    "replace": "历史聊天记录归属于已废弃的 Google3 项目"
                },
                {
                    "match": "^\\s+\\($",
                    "replace": "（"
                },
                {
                    "match": "^\\)\\.\\s+$",
                    "replace": "）。"
                },
                {
                    "match": "^New chats will be grouped by workspace\\.$",
                    "replace": "新对话将按工作区进行分组归类。"
                }
            ]
        },
        {
            "containerPattern": "^(?:Searching\\s+\\d+\\s+loaded\\s+(?:messages?|messagemessages)\\s+—\\s+older history available|正在搜索已加载的\\s+\\d+\\s*条消息\\s+—\\s+可加载更早历史记录)$",
            "nodeReplacements": [
                {
                    "match": "^Searching\\s+$",
                    "replace": "正在搜索已加载的 "
                },
                {
                    "match": "^\\s+loaded$",
                    "replace": " 条"
                },
                {
                    "match": "^\\s+$",
                    "replace": ""
                },
                {
                    "match": "^messages?$",
                    "replace": "消息"
                },
                {
                    "match": "^\\s+—\\s+older history available$",
                    "replace": " — 可加载更早历史记录"
                }
            ]
        },
        {
            "containerPattern": "^(?:No messages matching [“\"].+?[”\"](?:\\s+in loaded messages\\.\\.?|\\.)|未找到匹配[“\"].+?[”\"]的消息(?:（在已加载消息中）)?。)$",
            "nodeReplacements": [
                {
                    "match": "^No messages matching [“\"]$",
                    "replace": "未找到匹配“"
                },
                {
                    "match": "^[”\"]$",
                    "replace": "”的消息"
                },
                {
                    "match": "^\\s+in loaded messages\\.$",
                    "replace": "（在已加载消息中）。"
                },
                {
                    "match": "^\\.$",
                    "replace": "。"
                }
            ]
        }
    ],
