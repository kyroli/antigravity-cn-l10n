        "fragmentPatterns": [
            {
                "containerSelector": "#replay-label",
                "containerPattern": "^\\d+(?:\\s*(?:posts?|条.{1,4}))?\\s+(?:over|of)\\s+.+$",
                "nodeReplacements": [
                    {
                        "match": "^\\s+over\\s+(.+)$",
                        "replace": " · 耗时 $1",
                        "formatGroups": [
                            1
                        ]
                    },
                    {
                        "match": "^\\s+of\\s+(\\d+)\\s*·\\s*#(\\d+)\\s+at\\s+(.+?)\\s*\\(\\+(.+?)\\)\\s*$",
                        "replace": " / $1 · #$2 @ $3 (+$4)",
                        "formatGroups": [
                            4
                        ]
                    },
                    {
                        "match": "^\\s+of\\s+(\\d+)\\s*$",
                        "replace": " / $1"
                    }
                ]
            },
            {
                "containerSelector": ".o2-progt",
                "containerPattern": "^\\d+\\s*(?:of|/)\\s*\\d+\\s+tasks done$",
                "nodeReplacements": [
                    {
                        "match": "^\\s*tasks done\\s*$",
                        "replace": " 项任务已完成"
                    }
                ]
            },
            {
                "containerSelector": "#empty-body",
                "containerPattern": "^(?:Swarms started in this conversation appear here automatically|在此对话中启动的 Swarm 会自动显示在这里).*?/swarm(?:\\.| 即可启动。)$",
                "nodeReplacements": [
                    {
                        "match": "^Swarms started in this conversation appear here automatically, with their board, members and @mention graph\\. Start one with\\s*$",
                        "replace": "在此对话中启动的 Swarm 会自动显示在这里，包含消息板、成员列表和 @提及关系图。使用 "
                    },
                    {
                        "match": "^\\.$",
                        "replace": " 即可启动。"
                    }
                ]
            },
            {
                "containerSelector": "#empty-body",
                "containerPattern": "^(?:Open this pane from a conversation to see its swarm|请从对话中打开此面板以查看其 Swarm).*?/swarm(?:\\.| 即可启动。)$",
                "nodeReplacements": [
                    {
                        "match": "^Open this pane from a conversation to see its swarm\\. Swarms started there appear here automatically; start one with\\s*$",
                        "replace": "请从对话中打开此面板以查看其 Swarm。在该对话中启动的 Swarm 会自动显示在这里；使用 "
                    },
                    {
                        "match": "^\\.$",
                        "replace": " 即可启动。"
                    }
                ]
            }
        ],
